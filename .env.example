# MetaTrader 5 credentials (optional if terminal is already logged in)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=C:\Program Files\MetaTrader 5 EXNESS\terminal64.exe

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Multiple private chats: TELEGRAM_CHAT_ID=111,222
TELEGRAM_CHANNEL_ID=
# Bot username without @ — enables "Open private bot" deep-link from channel
TELEGRAM_BOT_USERNAME=
CHANNEL_UPDATES_ENABLED=true
CHANNEL_DIGEST_HOURS=4
CHANNEL_PRED_ENABLED=true
CHANNEL_PRED_MIN_SCORE=0.75
CHANNEL_PRED_COOLDOWN_HOURS=3
CHANNEL_PRED_MAX_PER_DAY=3

# Trading mode: true = paper/sandbox, false = live orders
PAPER_TRADING=true

# Symbol and model path (Exness often uses EURUSDm)
SYMBOL=EURUSDm
MODEL_PATH=models/ppo_forex.zip

# Multi-pair watchlist (max open = one active trade per symbol, capped below)
SYMBOLS=EURUSDm,GBPUSDm,USDJPYm,AUDUSDm,USDCADm,NZDUSDm,USDCHFm,EURJPYm,GBPJPYm,XAUUSDm,XAGUSDm,BTCUSDm,ETHUSDm,SOLUSDm,XRPUSDm,LTCUSDm,BNBUSDm
MAX_OPEN_POSITIONS=4
ENTRIES_PER_CYCLE=2
OPPORTUNITY_ALERT_MIN=0.85
OPPORTUNITY_ALERT_COOLDOWN_MIN=30
MIN_ENTRY_SCORE=0.72
# Positive-expectancy geometry: bounded SL / runners TP + BE trail
STOP_LOSS_ATR_MULT=1.5
TAKE_PROFIT_ATR_MULT=2.5
ROCKET_PULLBACK_PCT=0.30
ROCKET_BE_ATR=0.8
ROCKET_SCALP_ATR=2.0
ROCKET_HARD_LOSS_R=0.8
ROCKET_TRAIL_ATR=1.0
ROCKET_TIME_PROFIT_BARS=24
ROCKET_TIME_PROFIT_MIN_ATR=0.4
QUALITY_REQUIRE_OVERLAP=false
HOT_GRAB_SCORE=0.85
# Elite scores (>=0.88) skip Gemini for speed; below that get real veto
FAST_ENTRY_SCORE=0.88
GEMINI_FAST_SKIP=true
POLL_SECONDS=8
MAX_RISK_PER_TRADE=0.01
MAX_RISK_MONEY=500
MAX_LOT=2.0
CIRCUIT_BREAKER_ENABLED=true
# Halt new entries after this fraction of day-start equity is lost (3%).
DAILY_LOSS_LIMIT=0.03
# Flatten open positions when circuit breaker trips
CIRCUIT_BREAKER_FLATTEN=true
# Reject live entries when bid-ask > this fraction of ATR
MAX_SPREAD_ATR_FRACTION=0.15
# Max net signed currency legs across open positions
MAX_CURRENCY_EXPOSURE=2
LOSS_GUARD_SIZE_DOWN_AFTER=2
LOSS_GUARD_SIZE_DOWN_SCALE=0.5
REENTRY_COOLDOWN_MIN=20
REENTRY_COOLDOWN_WIN_MIN=5
DESK_PULSE_HOURS=1

# Macro / session filters
CALENDAR_BLACKOUT_MINUTES=15
SESSION_MODE=always

# Daily online learning (background — never blocks entries/exits)
ONLINE_LEARN_ENABLED=true
ONLINE_LEARN_BACKGROUND=true
ONLINE_LEARN_MAX_STEPS=4096
ONLINE_MICRO_STEPS=2048
ONLINE_LEARN_MIN_TRADES=5
ONLINE_LEARN_ON_CLOSES=3
ONLINE_LEARN_LR=1e-5

# Gemini advisor (pre-trade + Telegram compose)
GEMINI_API_KEY=
GEMINI_ENABLED=true
GEMINI_MODEL=gemini-3.6-flash
GEMINI_CACHE_SECONDS=180
GEMINI_GROUNDED_SEARCH=true
# Two-way desk coach chat in private Telegram (uses Gemini)
DESK_COACH_ENABLED=true
