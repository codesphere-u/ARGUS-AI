# ==============================================================================
# ARGUS AI 2.0 & ALPACA TRADING DESK CONFIGURATION
# ==============================================================================

# --- Alpaca Broker Configuration ---
# Leave blank for High-Fidelity Paper Simulation Engine
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=sip
ALPACA_STREAM_URL=wss://stream.data.alpaca.markets/v2/sip

# --- Google Gemini AI (Committee Reasoning) ---
# Leave blank for specialized deterministic heuristic engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2

# --- Watchlist & Risk Budgeting ---
ARGUS_WATCHLIST=NVDA,BTC/USD,TSLA,SPY,ETH/USD,AMD,AAPL,MSTR
MAX_ACCOUNT_RISK_PCT=1.0
MAX_POSITION_SIZE_USD=20000.0
MAX_DAILY_DRAWDOWN_PCT=3.0
MAX_CONSECUTIVE_LOSSES=3
VOLATILITY_FREEZE_VIX=38.0

# --- Interactive Alerts (Telegram / Discord) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- MetaTrader 5 (Optional MT5 bridge if running Forex Mode) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=C:\Program Files\MetaTrader 5 EXNESS\terminal64.exe
